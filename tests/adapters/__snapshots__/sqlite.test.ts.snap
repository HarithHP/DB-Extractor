-- Table "customers" PRIMARY KEY ("id");

-- Table "orders" PRIMARY KEY ("id");
",
  "04_foreign_keys.sql": "-- HHP Database Extractor
-- Engine: SQLite | Database: shop.db | Category: Foreign keys
-- Attached database: shop.db
PRAGMA foreign_keys = ON;

-- Table "orders": FOREIGN KEY ("customer_id") REFERENCES "customers" ("id") ON UPDATE NO ACTION ON DELETE CASCADE;
",
  "05_indexes.sql": "-- HHP Database Extractor
-- Engine: SQLite | Database: shop.db | Category: Indexes
-- Attached database: shop.db
PRAGMA foreign_keys = ON;

DROP INDEX IF EXISTS "idx_orders_customer";
CREATE INDEX IF NOT EXISTS idx_orders_customer ON orders(customer_id);
",
  "07_views.sql": "-- HHP Database Extractor
-- Engine: SQLite | Database: shop.db | Category: Views
-- Attached database: shop.db
PRAGMA foreign_keys = ON;

DROP VIEW IF EXISTS "v_customer_orders";
CREATE VIEW IF NOT EXISTS v_customer_orders AS
      SELECT c.id AS customer_id, c.email, COUNT(o.id) AS order_count
        FROM customers c
        LEFT JOIN orders o ON o.customer_id = c.id
       GROUP BY c.id, c.email;
",
  "10_triggers.sql": "-- HHP Database Extractor
-- Engine: SQLite | Database: shop.db | Category: Triggers
-- Attached database: shop.db
PRAGMA foreign_keys = ON;

DROP TRIGGER IF EXISTS "trg_orders_nonnegative";
CREATE TRIGGER IF NOT EXISTS trg_orders_nonnegative
    BEFORE INSERT ON orders
    BEGIN
      SELECT CASE WHEN NEW.total_cents < 0 THEN RAISE(ABORT, 'negative total') END;
    END;
",
