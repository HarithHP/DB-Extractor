exports[`sqliteAdapter > extracts tables, columns, keys, indexes, views, triggers + per-object files deterministically 1`] = `
{
  "01_tables.sql": "-- HHP Database Extractor
-- Engine: SQLite | Database: shop.db | Category: Tables
-- Attached database: shop.db
PRAGMA foreign_keys = ON;

DROP TABLE IF EXISTS "customers";
CREATE TABLE IF NOT EXISTS customers (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      email TEXT NOT NULL UNIQUE,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP
    );

DROP TABLE IF EXISTS "orders";
CREATE TABLE IF NOT EXISTS orders (
      id INTEGER PRIMARY KEY,
      customer_id INTEGER NOT NULL,
      total_cents INTEGER NOT NULL DEFAULT 0,
      FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE
    );
",
  "02_table_columns.sql": "-- HHP Database Extractor
-- Engine: SQLite | Database: shop.db | Category: Table columns
-- Attached database: shop.db
PRAGMA foreign_keys = ON;

-- Table: "customers"
  "id" INTEGER PRIMARY KEY (1),
  "email" TEXT NOT NULL,
  "created_at" TEXT DEFAULT CURRENT_TIMESTAMP;

-- Table: "orders"
  "id" INTEGER PRIMARY KEY (1),
  "customer_id" INTEGER NOT NULL,
  "total_cents" INTEGER NOT NULL DEFAULT 0;
",
  "03_primary_keys.sql": "-- HHP Database Extractor
-- Engine: SQLite | Database: shop.db | Category: Primary keys
-- Attached database: shop.db
